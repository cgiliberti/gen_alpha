# SQLite database file path (relative to project root)
DATABASE_URL="file:./dev.db"

# Anthropic API key — get one at https://console.anthropic.com/
# Required: used to analyze articles with Claude claude-opus-4-6
ANTHROPIC_API_KEY="sk-ant-..."

# Secret for protecting the /api/cron, /api/test-scraper, and /api/reanalyze endpoints.
# Also used to authenticate the admin dashboard UI.
# Use a long random string: openssl rand -hex 32
CRON_SECRET="change-this-to-a-long-random-string"

# Node environment (development | production)
NODE_ENV="development"

# Optional: override the server port (default: 3000)
# PORT=3000
